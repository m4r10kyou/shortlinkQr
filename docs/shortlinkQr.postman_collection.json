{
  "info": {
    "name": "shortlinkQr - API",
    "description": "Functional test collection for the shortlinkQr API.\n\nThe collection is organised in four folders:\n\n1. Links API - the happy paths of the management endpoints.\n2. Validation - requests that must be rejected by Bean Validation with 400 and a per-field `errors` map.\n3. Protocol errors - malformed or unsupported requests handled by ResponseEntityExceptionHandler.\n4. Redirect - the public endpoint a scanned QR code hits.\n\nEvery request carries a test script asserting the expected status, so the whole collection can be executed with the Collection Runner and read as a pass/fail report.\n\nVariables:\n- baseUrl: host of the running application (default http://localhost:9080)\n- lastCode: filled automatically by the first request, so later requests need no manual copying.\n- aliasCode: the custom alias used to exercise the conflict case.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9080", "type": "string" },
    { "key": "lastCode", "value": "", "type": "string" },
    { "key": "aliasCode", "value": "mi-repo", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Links API",
      "item": [
        {
          "name": "01 - Create link (minimal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "const base = pm.variables.get('baseUrl');",
                  "",
                  "pm.test('shortUrl is base + a single code', () => {",
                  "    const escaped = base.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');",
                  "    pm.expect(body.shortUrl).to.match(new RegExp('^' + escaped + '/[a-zA-Z0-9]{7}$'));",
                  "});",
                  "",
                  "pm.test('visitCount starts at zero', () => pm.expect(body.visitCount).to.eql(0));",
                  "pm.test('hasLogo is false', () => pm.expect(body.hasLogo).to.eql(false));",
                  "",
                  "pm.collectionVariables.set('lastCode', body.shortUrl.substring(body.shortUrl.lastIndexOf('/') + 1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://www.divinaseguros.com/\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Base case: only the destination. CodeGenerator produces a 7-character Base62 code.\n\nThe regex assertion fails if the code is ever appended twice to the base URL."
          }
        },
        {
          "name": "02 - Create link (custom alias)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 on first run, 409 on repeat', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.test('shortUrl ends with the requested alias', () => {",
                  "        pm.expect(pm.response.json().shortUrl).to.include(pm.variables.get('aliasCode'));",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://github.com/m4r10kyou/shortlinkQr\",\n  \"customAlias\": \"{{aliasCode}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Run once for 201. Request 03 then re-sends it to exercise the conflict path."
          }
        },
        {
          "name": "03 - Create link (alias already taken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('problem type identifies the conflict', () => {",
                  "    pm.expect(body.type).to.eql('urn:problem-type:alias-occupied');",
                  "});",
                  "pm.test('no Java internals leak into the body', () => {",
                  "    pm.expect(JSON.stringify(body)).to.not.include('com.m4r10kyou');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://example.com/otro\",\n  \"customAlias\": \"{{aliasCode}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Depends on 02 having run. AliasAlreadyExistsException -> 409."
          }
        },
        {
          "name": "04 - Create link (with expiry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('expiresAt is echoed back', () => pm.expect(pm.response.json().expiresAt).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://spring.io/projects/spring-boot\",\n  \"expiresAt\": \"2030-01-01T00:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Instant in ISO-8601 UTC, deserialised by Jackson."
          }
        },
        {
          "name": "05 - Get link by code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('management read does not count a visit', () => {",
                  "    pm.expect(pm.response.json().visitCount).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/links/{{lastCode}}", "host": ["{{baseUrl}}"], "path": ["api", "links", "{{lastCode}}"] },
            "description": "Uses the code captured by request 01.\n\nThe visitCount assertion is the regression guard for keeping getByCode separate from resolveCode: an inspection must never be recorded as a scan."
          }
        },
        {
          "name": "06 - Get link (unknown code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('problem type identifies the failure', () => {",
                  "    pm.expect(pm.response.json().type).to.eql('urn:problem-type:not-found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/links/noexiste", "host": ["{{baseUrl}}"], "path": ["api", "links", "noexiste"] },
            "description": "ShortLinkNotFoundException -> 404."
          }
        }
      ]
    },
    {
      "name": "2. Validation",
      "description": "Every request here must return 400 with an `errors` object naming the offending field.",
      "item": [
        {
          "name": "07 - Target URL is blank",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('targetUrl is reported', () => pm.expect(pm.response.json().errors).to.have.property('targetUrl'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"   \"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "The compact constructor trims to an empty string, so @NotBlank fires."
          }
        },
        {
          "name": "08 - Target URL has no scheme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('targetUrl is reported', () => pm.expect(pm.response.json().errors).to.have.property('targetUrl'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"esto-no-es-una-url\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "java.net.URI parses this as a relative reference, so the validator rejects it on the missing scheme and host."
          }
        },
        {
          "name": "09 - Target URL contains a space",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('targetUrl is reported', () => pm.expect(pm.response.json().errors).to.have.property('targetUrl'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://example.com/mi docu.pdf\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Regression test.\n\nThe original pattern accepted this. The link was stored and then failed with a 500 on the public redirect, because URI.create could not parse it. The custom @HttpUrl constraint now rejects it at the boundary."
          }
        },
        {
          "name": "10 - Target URL uses the mailto scheme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('targetUrl is reported', () => pm.expect(pm.response.json().errors).to.have.property('targetUrl'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"mailto:alguien@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "A syntactically valid URI that is not a web address. Parsing alone is not enough: the validator also checks the scheme."
          }
        },
        {
          "name": "11 - Target URL uses the ftp scheme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('targetUrl is reported', () => pm.expect(pm.response.json().errors).to.have.property('targetUrl'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"ftp://files.example.com/doc.pdf\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Has a scheme and a host, but not one the redirect endpoint can serve."
          }
        },
        {
          "name": "12 - Target URL exceeds 2048 characters",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('longPath', 'a'.repeat(2100));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('targetUrl is reported', () => pm.expect(pm.response.json().errors).to.have.property('targetUrl'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://example.com/{{longPath}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "@Size(max = 2048) matches the column length, so validation fails before the database would."
          }
        },
        {
          "name": "13 - Alias is too short",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('customAlias is reported', () => pm.expect(pm.response.json().errors).to.have.property('customAlias'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://www.google.com/\",\n  \"customAlias\": \"ab\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "@Size(min) only."
          }
        },
        {
          "name": "14 - Alias contains illegal characters",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('customAlias is reported', () => pm.expect(pm.response.json().errors).to.have.property('customAlias'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://www.google.com/\",\n  \"customAlias\": \"mi alias/con espacios\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "@Pattern only: the value is long enough to satisfy @Size.\n\nWithout this rule a slash in an alias would break routing."
          }
        },
        {
          "name": "15 - Alias breaks both rules at once",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "",
                  "const message = pm.response.json().errors.customAlias;",
                  "",
                  "pm.test('both violations are merged into one entry', () => {",
                  "    pm.expect(message).to.include('letters');",
                  "    pm.expect(message).to.include('between');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://www.google.com/\",\n  \"customAlias\": \"a!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Two characters and an illegal one, so @Size and @Pattern both fail on the same field.\n\nThis is the request that exercises the merge function of Collectors.toMap. Without it, collecting two violations under one key throws IllegalStateException and the 400 turns into a 500.\n\nThe assertions check for substrings rather than the whole message: Bean Validation does not guarantee the order in which constraints on one field are evaluated."
          }
        },
        {
          "name": "16 - Expiry date is in the past",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('expiresAt is reported', () => pm.expect(pm.response.json().errors).to.have.property('expiresAt'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://www.google.com/\",\n  \"expiresAt\": \"2020-01-01T00:00:00Z\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "@Future."
          }
        }
      ]
    },
    {
      "name": "3. Protocol errors",
      "description": "Handled by ResponseEntityExceptionHandler. Before the advice extended it, every one of these returned 500 - caller mistakes reported as server failures, which pollutes the signal operational alerting depends on.",
      "item": [
        {
          "name": "17 - Malformed JSON body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400, not 500', () => pm.response.to.have.status(400));",
                  "pm.test('parser internals stay out of the response', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('jackson');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://example.com\n}" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "Unterminated string. HttpMessageNotReadableException -> 400."
          }
        },
        {
          "name": "18 - Unsupported method",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 Method Not Allowed', () => pm.response.to.have.status(405));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"targetUrl\": \"https://example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/links/{{lastCode}}", "host": ["{{baseUrl}}"], "path": ["api", "links", "{{lastCode}}"] },
            "description": "HttpRequestMethodNotSupportedException -> 405. Re-targeting a link is not implemented yet; it needs an authorization mechanism first."
          }
        },
        {
          "name": "19 - Unsupported media type",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('415 Unsupported Media Type', () => pm.response.to.have.status(415));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "text/plain" }],
            "body": { "mode": "raw", "raw": "targetUrl=https://example.com" },
            "url": { "raw": "{{baseUrl}}/api/links", "host": ["{{baseUrl}}"], "path": ["api", "links"] },
            "description": "HttpMediaTypeNotSupportedException -> 415."
          }
        }
      ]
    },
    {
      "name": "4. Redirect",
      "description": "The public endpoint a scanned QR code hits. These requests have redirect following disabled so the 302 itself is visible; with it enabled Postman shows the destination's response instead.",
      "item": [
        {
          "name": "20 - Resolve a code",
          "protocolProfileBehavior": { "followRedirects": false },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('302 Found, not 301', () => pm.response.to.have.status(302));",
                  "",
                  "pm.test('Location points at the destination', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('response is not cacheable', () => {",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-cache');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/{{lastCode}}", "host": ["{{baseUrl}}"], "path": ["{{lastCode}}"] },
            "description": "301 would let browsers cache the destination permanently, so a printed QR code could never be re-pointed. The status assertion is the regression guard for the project's core promise."
          }
        },
        {
          "name": "21 - Resolve counts a visit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('visitCount advanced past zero', () => {",
                  "    pm.expect(pm.response.json().visitCount).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/links/{{lastCode}}", "host": ["{{baseUrl}}"], "path": ["api", "links", "{{lastCode}}"] },
            "description": "Run straight after 20. Reads the same link through the management endpoint to confirm the redirect incremented the counter.\n\nTogether with request 05 this pins both halves of the rule: resolving counts, inspecting does not."
          }
        },
        {
          "name": "22 - Resolve an unknown code",
          "protocolProfileBehavior": { "followRedirects": false },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/noexiste", "host": ["{{baseUrl}}"], "path": ["noexiste"] },
            "description": "Known limitation: a person who scans a dead QR code receives an RFC 7807 JSON document in their browser. Correct for an API, poor for a human. An HTML error page for this endpoint is pending."
          }
        },
        {
          "name": "23 - Path that cannot be a code",
          "protocolProfileBehavior": { "followRedirects": false },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "",
                  "pm.test('handled as a missing resource, not as a missing link', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.include('urn:problem-type:not-found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/favicon.ico", "host": ["{{baseUrl}}"], "path": ["favicon.ico"] },
            "description": "The path variable is constrained to the shape of a code, so requests that cannot possibly be one never reach the service or the database.\n\nThis matters because the redirect endpoint sits at the site root: without the constraint, every scanner probing for /wp-admin or /.env would cost a query."
          }
        }
      ]
    }
  ]
}
